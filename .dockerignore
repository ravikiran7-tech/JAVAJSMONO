# Docker ignore file for Java Maven projects
# Build outputs
target/
build/
*.class
*.jar
*.war

# Maven wrapper files (CRITICAL: exclude these)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper files (CRITICAL: exclude these)
gradlew
gradlew.bat
gradle/wrapper/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# OS files
.DS_Store
Thumbs.db

# Git files
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/

# Test files
src/test/

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.swp
*~
